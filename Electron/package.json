{
  "name": "careconnect-desktop-app",
  "productName": "CareConnect Desktop App",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "node electron/run-dev.cjs",
    "desktop:build": "vite build --mode desktop",
    "desktop:start": "node electron/run-dist.cjs",
    "desktop:installer": "vite build --mode desktop && electron-builder --win nsis",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.careconnect.desktop",
    "productName": "CareConnect Desktop App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.50.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
