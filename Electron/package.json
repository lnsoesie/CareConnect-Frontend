{
  "name": "careconnect",
  "private": true,
  "version": "2.4.1",
  "main": "electron/main.cjs",
 "scripts": {
  "dev": "vite",
  "build": "vite build",
  "preview": "vite preview",
  "format": "oxfmt",
  "test": "jest",
  "electron:dev": "concurrently -k -n Vite,Electron -c cyan,magenta \"vite --port 3000\" ...\"wait-on tcp:3000 && cross-env NODE_ENV=development electron electron/main.cjs\"",
    "electron:build": "cross-env ELECTRON_BUILD=true vite build && electron-builder --dir",
    "electron:pack": "cross-env ELECTRON_BUILD=true vite build && electron-builder"
  },
  "build": {
    "appId": "com.careconnect.health",
    "productName": "CareConnect",
    "copyright": "© 2026 CareConnect Health",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "icon": "public/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "MedicalSoftware"
    }
  },
  "dependencies": {
    "lucide-react": "^1.50.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "wait-on": "^9.4.0"
  }
}
